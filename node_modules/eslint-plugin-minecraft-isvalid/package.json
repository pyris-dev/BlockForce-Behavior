{
  "name": "eslint-plugin-minecraft-isvalid",
  "version": "0.4.0",
  "description": "Type-aware ESLint rules that enforce isValid() checks on @minecraft/server references after invalidation points.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "minecraft",
    "bedrock",
    "minecraft-scripting",
    "isvalid",
    "typescript"
  ],
  "homepage": "https://github.com/smell-of-curry/eslint-plugin-minecraft-isvalid#readme",
  "bugs": {
    "url": "https://github.com/smell-of-curry/eslint-plugin-minecraft-isvalid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smell-of-curry/eslint-plugin-minecraft-isvalid.git"
  },
  "license": "MIT",
  "author": "Smell of curry",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "valid-types": [
        "valid-types.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./valid-types": {
      "types": "./valid-types.d.ts",
      "default": "./valid-types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "valid-types.d.ts",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/rule-tester": "^8.59.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
