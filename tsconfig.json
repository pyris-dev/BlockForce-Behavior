{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "lib": ["ES2021", "DOM"],
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "sourceMap": false,
    "outDir": "scripts",
    "experimentalDecorators": true,
    "noEmitOnError": true
  },
  "include": ["src", "utils"],
  "exclude": [
    "node_modules/**/*",
    "utils/build.ts",
    "utils/manifestGen.ts"
  ]
}
